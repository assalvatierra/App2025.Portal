@{
    ViewData["Title"] = !string.IsNullOrWhiteSpace(ViewBag.SeoTitle) ? ViewBag.SeoTitle : "";
    ViewData["Description"] = !string.IsNullOrWhiteSpace(ViewBag.SeoDescription) ? ViewBag.SeoDescription : string.Empty;
}

<main id="primary" class="content-area">
    @Html.Raw(ViewBag.ContentData)
    @if (ViewBag.CtaBox != null)
    {
        var ctaBoxModel = (App2025.Portal.Models.CtaBoxViewModel)ViewBag.CtaBox;
        if (ViewBag.ItemId != null)
        {
            ctaBoxModel.ItemId = ViewBag.ItemId.ToString();
        }
        @await Html.PartialAsync("_CtaBox", ctaBoxModel)
    }

</main>
