<!-- ==========================================
     SECTION 6: FREQUENTLY ASKED QUESTIONS
     ========================================== -->
<section class="seo-faq-section" aria-labelledby="faq-heading">
    <h2 id="faq-heading">Frequently Asked Questions About Car Rental</h2>

    <!-- Use structured semantic details tag for excellent mobile user-experience and clean layout -->
    <div class="faq-accordion-wrapper">
        @if (ViewBag.Faq != null)
        {
            foreach (var faq in ViewBag.Faq)
            {
                <details class="faq-item">
                    <summary><strong>@faq.Title</strong></summary>
                    <div class="faq-answer">
                        <p>@faq.Description</p>
                    </div>
                </details>
            }
        }
    </div>
    <div class="all-locations-btn-container">
        <a href="/Home/FaqList" class="btn-secondary">View All Rental FAQs</a>
    </div>

</section>
