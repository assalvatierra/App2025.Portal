@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration

@{
    ViewData["Title"] = ViewBag.Title ?? "Portal";
    ViewData["Description"] = ViewBag.Description ?? "Portal Description";

    var sections = ViewBag.HomeSections as List<HomeSection>;
    var hasProductCategoriesSection = sections?.Any(s => s.Section == "ProductCategories") ?? false;
    var hasServicesSection = sections?.Any(s => s.Section == "Services") ?? false;
    var hasWhyusSection = sections?.Any(s => s.Section == "WhyUs") ?? false;
    var hasFeaturedArticlesSection = sections?.Any(s => s.Section == "FeaturedArticles") ?? false;
    var hasFaqSection = sections?.Any(s => s.Section == "Faq") ?? false;
    var hasRegularSearchSection = sections?.Any(s => s.Section == "RegularSearch") ?? false;
    var hasVectorSearchSection = sections?.Any(s => s.Section == "VectorSearch") ?? false;

    var regularSearchSection = sections?.FirstOrDefault(s => s.Section == "RegularSearch");
    var vectorSearchSection = sections?.FirstOrDefault(s => s.Section == "VectorSearch");
    var productCategoriesSection = sections?.FirstOrDefault(s => s.Section == "ProductCategories");
    var servicesSection = sections?.FirstOrDefault(s => s.Section == "Services");
    var whyUsSection = sections?.FirstOrDefault(s => s.Section == "WhyUs");
    var featuredArticlesSection = sections?.FirstOrDefault(s => s.Section == "FeaturedArticles");
    var faqSection = sections?.FirstOrDefault(s => s.Section == "Faq");
}

@* Include the Compare Toast Component *@
@await Html.PartialAsync("_CompareToast")

<!-- ==========================================
     SECTION 1: THE HERO & BOOKING WIDGET
     ========================================== -->
<header class="seo-hero-section">
    <div class="hero-container">
        <!-- Target your primary high-volume broad keyword here -->
        <h1>@(ViewBag.H1Title ?? "H1 Title")</h1>
        <p class="hero-subtitle">@(ViewBag.H1Subtitle ?? "H1 SubTitle")</p>

        <!-- Booking Widget Container (Replace with your actual form/booking plugin iframe) -->
        <div class="booking-widget-box" aria-label="Car Rental Reservation Form">

@* TODO: Update the search section to be flexible to any kind of business. as of now, regular search is car rental specific. *@
            <!-- ========== SEARCH OPTION 1: Regular Text Match Search ========== -->
            @if (hasRegularSearchSection)
            {
                <div class="search-section">
                    <h3 class="search-section-title">@(regularSearchSection?.Title ?? "Search by Type, Model, or Manufacturer")</h3>
                    <p class="search-section-description">@(regularSearchSection?.Intro ?? "Use traditional text search to find vehicles by exact specifications.")</p>
                    <form asp-controller="Home" asp-action="SearchItems" method="get" class="search-form">
                        <div class="form-row">
                            <div class="form-group">
                                <label for="search-term">Search Items</label>
                                <input type="text" id="search-term" name="searchTerm" placeholder="Search by Type, Model or Manufacturer" required>
                            </div>
                            <div class="form-group">
                                <label for="pickup-date">Pick-up Date</label>
                                <input type="date" id="pickup-date" name="pickup_date">
                            </div>
                            <div class="form-group">
                                <label for="return-date">Return Date</label>
                                <input type="date" id="return-date" name="return_date">
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="passenger-capacity">Passenger Capacity</label>
                                <input type="number" id="passenger-capacity" name="passenger_capacity" min="1">
                            </div>
                            <div class="form-group">
                                <label for="luggage-capacity">Luggage Capacity</label>
                                <input type="number" id="luggage-capacity" name="luggage_capacity" min="1">
                            </div>
                            <div class="form-group">
                                <label for="transmission">Transmission</label>
                                <select id="transmission" name="transmission">
                                    <option value="automatic">Automatic</option>
                                    <option value="manual">Manual</option>
                                    <option value="any" selected>Any</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>Submit to search</label>
                                <button type="submit" class="btn-search">Find My Car</button>
                            </div>
                        </div>
                    </form>
                </div>
            }

            <!-- ========== SEARCH OPTION 2: AI-Vector Search ========== -->
            @if (hasVectorSearchSection)
            {
                <div class="search-section" style="margin-top: 2rem; padding-top: 2rem; border-top: 2px solid #ddd;">
                    <h3 class="search-section-title">@(vectorSearchSection?.Title ?? "Semantic Search")</h3>
                    <p class="search-section-description">@(vectorSearchSection?.Intro ?? "Search Semantically")</p>
                    <form asp-controller="Home" asp-action="SearchByVector" method="get" class="search-form">
                        <div class="form-row">
                            <div class="form-group">
                                <label for="vector-search-term">@(vectorSearchSection?.FieldLabel ?? "Describe the item you want")</label>
                                <input type="text" id="vector-search-term" name="query" placeholder="@(vectorSearchSection?.FieldText ?? "e.g., 'Item for '")" required>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>@(vectorSearchSection?.ButtonLabel ?? "Search with AI Intelligence")</label>
                                <button type="submit" class="btn-search" style="background-color: #6c757d;">
                                    <i class="bi bi-search"></i> @(vectorSearchSection?.ButtonText ?? "Search with AI")
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            }

            <!-- ========== Quick Actions ========== -->
            <div class="form-row" style="margin-top: 2rem; border-top: 2px solid #ddd; padding-top: 1rem;">
                <div class="form-group">
                    <label>Quick Actions</label>
                    <div style="display: flex; gap: 10px;">
                        <a href="@Url.Action("ReservationForm", "PortalReservation", new { itemId = 0, transactionType = "Booking" })" class="btn btn-outline-primary" style="flex: 1; text-align: center;">
                            <i class="bi bi-calendar-check"></i> Reserve Now
                        </a>
                        <a href="@Url.Action("ReservationForm", "PortalReservation", new { itemId = 0, transactionType = "Quote" })" class="btn btn-outline-primary" style="flex: 1; text-align: center;">
                            <i class="bi bi-clipboard-check"></i> Request Quote
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</header>

<!-- ==========================================
     SECTION 2: CORE FLEET CATEGORIES
     ========================================== -->
@if(hasProductCategoriesSection){
    <section class="seo-fleet-section" aria-labelledby="fleet-heading">
        <h2 id="fleet-heading">@(productCategoriesSection?.Title ?? "Explore Our Products")</h2>
        <p class="section-intro">@(productCategoriesSection?.Intro ?? "Select from our wide range of Products")</p>

        <div class="fleet-grid">
            @if (ViewBag.ProductCategories != null)
            {
                foreach (var category in ViewBag.ProductCategories)
                {
                    <div class="fleet-card">
                        <article class="fleet-card">
                            <img src="@category.ImageUrl" alt="@category.Title @(productCategoriesSection?.ExtraInfo?? "")" loading="lazy">
                        <h3>@category.Title</h3>
                        <p>@(category.Description ?? "Explore this category.")</p>
                        <a href="@category.PageUrl" class="fleet-link">Browse @category.Title</a>
                        </article>
                    </div>
                }
            }
        </div>

    </section>
}
<!-- ==========================================
     SECTION 3: SERVICES

     ========================================== -->
@if(hasServicesSection)
{
    <section class="seo-locations-section" aria-labelledby="locations-heading">
        <h2 id="locations-heading">@(servicesSection?.Title ?? "Services")</h2>
        <p class="section-intro">@(servicesSection?.Intro ?? "Highly rated services")</p>

        <div class="locations-list">
            @if (ViewBag.ServiceCategories != null)
            {
                foreach (var service in ViewBag.ServiceCategories)
                {
                    <div class="location-item">
                        <img src="@service.ImageUrl"
                        alt="@service.Title @(servicesSection?.ExtraInfo?? "")"
                        loading="lazy"
                        width="230"
                        height="150">
                        <h3>@service.Title</h3>
                        <p>@(service.Description ?? "Convenient service location for all your rental needs.")</p>
                        <a href="@service.PageUrl" class="location-link">@service.Title Services</a>
                    </div>
                }
            }
        </div>
        <div class="all-locations-btn-container">
            <a href="/Home/OurServices" class="btn-secondary">View All Rental Services</a>
        </div>
    </section>
}
<!-- ==========================================
     SECTION 4: WhyUs (VALUE PROP & HOW IT WORKS)
     ========================================== -->
@if (hasWhyusSection)
{
    <section class="seo-value-section" aria-labelledby="value-heading">
        <h2 id="value-heading">@(whyUsSection?.Title ?? "Why Choose Us For Your Next Road Trip?")</h2>

        <div class="value-grid">
            @if (ViewBag.WhyUs != null)
            {
                foreach (var whyus in ViewBag.WhyUs)
                {
                    <div class="value-prop-item">
                        @if (!string.IsNullOrEmpty(whyus.ImageUrl))
                        {
                            <img src="@whyus.ImageUrl" 
                            alt="@whyus.Title" 
                            loading="lazy"
                            width="60"
                            height="60"
                            class="value-icon">
                        }
                        <h3>@whyus.Title</h3>
                        <p>@(whyus.Description ?? "Discover the benefits of choosing our car rental services.")</p>
                    </div>
                }
            }
        </div>
    </section>
}
<!-- ==========================================
     SECTION 5: FEATURED ARTICLES
     ========================================== -->
@if (hasFeaturedArticlesSection)
{
    <section class="seo-locations-section" aria-labelledby="locations-heading">
        <h2 id="locations-heading">@(featuredArticlesSection?.Title ?? "Featured Articles")</h2>
        <p class="section-intro">@(featuredArticlesSection?.Intro ?? "Stay informed with our latest insights and tips for a seamless car rental experience.")</p>

    <div class="locations-list">
        @if (ViewBag.FeaturedArticles != null)
        {
            foreach (var article in ViewBag.FeaturedArticles)
            {
                <div class="location-item">
                    <img src="@article.ImageUrl"
                         alt="@article.Title @(featuredArticlesSection?.ExtraInfo?? "")"
                         loading="lazy"
                         width="230"
                         height="150">
                    <h3>@article.Title</h3>
                    <p>@(article.Description ?? "")</p>
                    <a href="@article.PageUrl" class="location-link">@article.Title Services</a>
                </div>
            }
        }
    </div>
    <div class="all-locations-btn-container">
        <a href="/Home/Articles" class="btn-secondary">View All Car Rental Articles</a>
    </div>

    </section>
}

<!-- ==========================================
     SECTION 5: SOCIAL PROOF & TRUST (E-E-A-T)
     ========================================== -->
