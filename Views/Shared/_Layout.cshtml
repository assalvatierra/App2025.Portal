<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@ViewData["Description"]" />
    @RenderSection("HeadMeta", required: false)
    <title>@ViewData["Title"] - @(string.IsNullOrEmpty((string)ViewData["PortalName"]) ? "AJ Davao Car Rental" : ViewData["PortalName"]) </title>
    <script type="importmap"></script>
    @{
        var canonicalHost = Context.Request.Host.Host;
        if (canonicalHost.StartsWith("www.", StringComparison.OrdinalIgnoreCase))
        {
            canonicalHost = canonicalHost.Substring(4);
        }
        var canonicalUrl = $"{Context.Request.Scheme}://{canonicalHost}{Context.Request.Path}";
    }
    <link rel="canonical" href="@canonicalUrl" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Lato:wght@700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/footer.css" asp-append-version="true" />
    <style>
        :root { --brand:#0d6efd; --nav-bg:#f8fbff; --nav-gradient: linear-gradient(90deg,#ffffff,#f0f6ff); }
        body { font-family: 'Inter', system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial; }
        .navbar-custom { background: var(--nav-bg); background-image: var(--nav-gradient); border-bottom: 1px solid rgba(13,110,253,0.08); }
        .navbar-brand { font-family: 'Lato', system-ui, sans-serif; font-size:1.25rem; color:var(--brand); }
        .navbar-brand .brand-icon { font-size:1.5rem; color:var(--brand); }
        .nav-link { color:#333 !important; padding: 0.5rem 0.75rem; }
        .nav-link:hover { color: var(--brand) !important; background: rgba(13,110,253,0.04); border-radius:6px; }
        .navbar .btn-cta { background: var(--brand); color:#fff; border-radius:0.5rem; padding:0.45rem 0.9rem; font-weight:600; box-shadow: 0 4px 12px rgba(13,110,253,0.12); }
        .navbar .logo-pill { display:inline-flex; align-items:center; gap:.6rem; padding:.25rem .6rem; border-radius:.45rem; background:rgba(13,110,253,0.06); }
        @@media (max-width: 767px) { .navbar .btn-cta { display:inline-block; margin-top:.5rem; } }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center logo-pill" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2 brand-icon me-2" aria-hidden="true"></i>
                    <span class="fw-bold">@(string.IsNullOrEmpty((string)ViewData["PortalName"]) ? "AJ Davao Car Rental" : ViewData["PortalName"])</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-between" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="OurProducts">Our Fleet</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="OurServices">Car Rental Services</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Articles">Car Rental Blogs</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="FaqList">FAQs</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a></li>
                        @* <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="AskAI">Ask AI</a></li> *@
                    </ul>
                    <!--
                    <div class="d-flex align-items-center gap-2">
                        <partial name="_LoginPartial" />
                        <a class="btn btn-cta ms-2 d-none d-lg-inline-block" asp-area="" asp-controller="Home" asp-action="Contact">Get Started</a>
                    </div>
                    -->
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

   <partial name="PrefooterPartial" />

    <footer class="border-top footer text-muted">
        <div class="container" style="color: #ecf0f1;">
            &copy; 2026 - @(string.IsNullOrEmpty((string)ViewData["PortalName"]) ? "AJ Davao Car Rental" : ViewData["PortalName"]) - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "AutoRental",
  "@@id": "https://www.ajdavaocarrental.com/#business",
  "name": "AJ Davao Car Rental",
  "url": "https://www.ajdavaocarrental.com/",
  "image": "https://www.ajdavaocarrental.com/images/logo.png",
  "telephone": "+63-926-733-5449",
  "address": {
    "@@type": "PostalAddress",
    "streetAddress": "Matina Pangi Rd, Matina Crossing",
    "addressLocality": "Davao City",
    "addressRegion": "Davao del Sur",
    "postalCode": "8000",
    "addressCountry": "PH"
  },
  "geo": {
    "@@type": "GeoCoordinates",
    "latitude": "7.06105410620412",
    "longitude": "125.57030671698767"
  },
  "openingHours": "Mo-Su 08:00-20:00",
  "sameAs": [
    "https://www.facebook.com/AjDavaoCarRentals",
    "https://maps.app.goo.gl/wnKZyumZTW8WVxxs7"
  ],
  "areaServed": [
    {
      "@@type": "City",
      "name": "Davao City"
    },
    {
      "@@type": "Country",
      "name": "Philippines"
    },
    {
      "@@type": "Airport",
      "name": "Davao International Airport"
    }
  ]
}
    </script>
    @await RenderSectionAsync("StructuredData", required: false)
</body>
</html>
