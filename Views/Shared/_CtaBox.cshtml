@model App2025.Portal.Models.CtaBoxViewModel

@{
    var title = Model?.SectionTitle ?? "Ready to hit the road?";
    var description = Model?.SectionIntro ?? " Reserve your ride today!";
    var contactTitle = Model?.ContactInfo?.ContactTitle ?? "Contact Information";
    var showChat = Model?.ShowChat ?? false;
    var showMobile = Model?.ShowMobile ?? false;
    var showEmail = Model?.ShowEmail ?? false;
    var showFacebook = Model?.ShowFacebook ?? false;
}

<section class="section">
    <h2>@title</h2>
    <p>
        @description
    </p>
    <div class="cta-box">

        @if (Model?.Actions != null && Model.Actions.Any())
        {
            <div class="form-row">
                <div class="form-group">
                    <label> </label>
                    <div style="display: flex; gap: 10px;">
                        @foreach (var action in Model.Actions)
                        {
                            <a href="@action.Url" class="btn btn-primary" style="flex: 1; text-align: center; height: 4rem; display: flex; align-items: center; justify-content: center; flex-direction: column;">
                                @if (!string.IsNullOrEmpty(action.Icon))
                                {
                                    <i class="bi bi-@action.Icon"></i>
                                }
                                @action.Text
                            </a>
                        }
                    </div>
                </div>
            </div>
        }


        @if (Model?.ContactInfo != null)
        {
            <div style="margin-top: 1rem; ">
                <h4 style="font-size: 1.1rem; font-weight: 600; color: #333; margin-bottom: 1.5rem;">@contactTitle</h4>
                    @if (showChat && !string.IsNullOrEmpty(Model.ContactInfo.Chat))
                    {
                <p><strong>CHAT:</strong> @Model.ContactInfo.Chat</p>
                    }
                    @if (showMobile && !string.IsNullOrEmpty(Model.ContactInfo.Mobile))
                    {
                <p><strong>MOBILE:</strong> @Model.ContactInfo.Mobile</p>
                    }
                    @if (showEmail && !string.IsNullOrEmpty(Model.ContactInfo.Email))
                    {
                <p><strong>E-mail:</strong> @Model.ContactInfo.Email</p>
                    }
                    @if (showFacebook && !string.IsNullOrEmpty(Model.ContactInfo.Facebook))
                    {
                <p><strong>Facebook:</strong> @Model.ContactInfo.Facebook</p>
                    }
            </div>
        }
    </div>


    @if (Model?.Tags != null && Model.Tags.Any())
    {
        <p class="tags">
            Tagged: @foreach (var tag in Model.Tags)
            {
                <span>@tag</span>
                if (tag != Model.Tags.Last())
                {
                    <text>, </text>
                }
            }
        </p>
    }
</section>
